/*
 * USB Audio headset node — solo para broadcast_source (CONFIG_AUDIO_SOURCE_USB=y)
 * Requerido por audio_usb.c: DEVICE_DT_GET(DT_NODELABEL(hs_0))
 * No incluir en builds sink para evitar habilitar el stack USB innecesariamente.
 */

/ {
	hs_0: hs_0 {
		compatible = "usb-audio-hs";
		mic-feature-mute;
		mic-channel-l;
		mic-channel-r;
		hp-feature-mute;
		hp-channel-l;
		hp-channel-r;
	};
};

/*
 * CDC-ACM UART virtual — canal de control JSON para WebSerial.
 * Debe ir bajo el nodo del controlador USB (zephyr_udc0 / usbd).
 * Requerido para que CONFIG_USB_CDC_ACM se active.
 * Referenciado en usb_serial_ctrl.c: DEVICE_DT_GET(DT_NODELABEL(cdc_acm_uart1))
 */
&zephyr_udc0 {
	cdc_acm_uart1: cdc_acm_uart1 {
		compatible = "zephyr,cdc-acm-uart";
		/* sin hw-flow-control: WebSerial no gestiona RTS/CTS */
	};
};
